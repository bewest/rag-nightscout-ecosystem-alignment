<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lab harness for tools/lab/hub-active-state. run.sh copies this directory into a Nocturne
    source tree at tests/Lab/HubActiveState/ so the tree's Directory.Packages.props and
    global.json apply, then builds and runs it. Not part of Nocturne's solution.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <NoWarn>$(NoWarn);NU1608;NU1605;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\API\Nocturne.API\Nocturne.API.csproj" />
    <ProjectReference Include="..\..\Shared\Nocturne.Tests.Shared\Nocturne.Tests.Shared.csproj" />
  </ItemGroup>
</Project>
