+func TestClinicalDiagnosticQueueBytes(t *testing.T) {
+	for _, cancelSecond := range []bool{false, true} {
+		t.Run(map[bool]string{false: "checkpoint-held", true: "cancelled-acquire"}[cancelSecond], func(t *testing.T) {
+			var buffer bytes.Buffer
+			trace := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &buffer, 4096, 2097152)
+			probe := New(&Config{}, diagnosticStore{})
+			subscriptions, _ := (diagnosticStore{}).GetSubscriptions(context.Background(), "", "", "")
+			message, err := newNotifyMsg(diagnosticEvent(diagnosticA, "0/100"), subscriptions, probe.serialiser)
+			if err != nil {
+				t.Fatal(err)
+			}
+			n := New(&Config{MaxQueueBytes: int64(message.size()), URLWorkerCount: 1, Backoff: backoff.Config{DisableRetries: true}}, diagnosticStore{})
+			n.diagnosticTrace = trace
+			entered, releaseHTTP, checkpointEntered, releaseCheckpoint := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+			calls := 0
+			checkpoints := 0
+			n.client = diagnosticClient(func(req *http.Request) (*http.Response, error) {
+				calls++
+				if calls == 1 {
+					close(entered)
+					<-releaseHTTP
+				}
+				return &http.Response{StatusCode: 204, Body: io.NopCloser(strings.NewReader(""))}, nil
+			})
+			n.checkpointer = func(ctx context.Context, positions []wal.CommitPosition) error {
+				checkpoints++
+				if checkpoints == 1 {
+					close(checkpointEntered)
+					<-releaseCheckpoint
+				}
+				return nil
+			}
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- n.Notify(ctx) }()
+			first := make(chan error, 1)
+			go func() { first <- n.ProcessWALEvent(ctx, diagnosticEvent(diagnosticA, "0/100")) }()
+			<-entered
+			if err := <-first; err != nil {
+				t.Fatal(err)
+			}
+			secondCtx, cancelAcquire := context.WithCancel(ctx)
+			defer cancelAcquire()
+			second := make(chan error, 1)
+			go func() { second <- n.ProcessWALEvent(secondCtx, diagnosticEvent(diagnosticB, "0/200")) }()
+			diagnosticAwait(t, trace, &buffer, "queue-bytes-wait", diagnosticB)
+			diagnosticAwait(t, trace, &buffer, "message-ready", diagnosticB)
+			before := diagnosticRows(t, trace, &buffer)
+			if diagnosticPhase(before, "handoff-wait", diagnosticB) || diagnosticPhase(before, "queue-bytes-acquired", diagnosticB) {
+				t.Fatal("QUEUE_BYTES_NOT_HELD_THROUGH_DELIVERY")
+			}
+			if cancelSecond {
+				cancelAcquire()
+				if err := <-second; !errors.Is(err, context.Canceled) {
+					t.Fatal("ACQUIRE_CONTEXT_ERROR_CHANGED", err)
+				}
+				diagnosticAwait(t, trace, &buffer, "queue-bytes-refusal", diagnosticB)
+			}
+			close(releaseHTTP)
+			<-checkpointEntered
+			if diagnosticPhase(diagnosticRows(t, trace, &buffer), "queue-bytes-acquired", diagnosticB) {
+				t.Fatal("QUEUE_BYTES_NOT_HELD_THROUGH_CHECKPOINT")
+			}
+			close(releaseCheckpoint)
+			if !cancelSecond {
+				if err := <-second; err != nil {
+					t.Fatal(err)
+				}
+				diagnosticAwait(t, trace, &buffer, "send-return", diagnosticB)
+				if !diagnosticPhase(diagnosticRows(t, trace, &buffer), "queue-bytes-acquired", diagnosticB) {
+					t.Fatal("QUEUE_ACQUIRED_EVENT_REQUIRED")
+				}
+			}
+			cancel()
+			<-done
+			rows := diagnosticRows(t, trace, &buffer)
+			if !diagnosticPhase(rows, "queue-bytes-fast", diagnosticA) {
+				t.Fatal("FAST_PATH_REQUIRED")
+			}
+			for _, r := range rows {
+				if len(r.Instance) != 32 || r.PID < 1 || r.Instance != trace.instance {
+					t.Fatal("PROCESS_INSTANCE_REQUIRED")
+				}
+			}
+		})
+	}
+}
