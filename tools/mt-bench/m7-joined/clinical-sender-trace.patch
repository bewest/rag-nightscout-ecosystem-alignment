+func TestClinicalDiagnosticIntegrity(t *testing.T) {
+	for _, limit := range []struct{ rows, bytes int }{{1, 2097152}, {4096, 1}} {
+		var b bytes.Buffer
+		tr := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &b, limit.rows, limit.bytes)
+		m := tr.bind(diagnosticEvent(diagnosticA, "0/100"))
+		tr.emit("message-ready", m, diagnosticFields{})
+		tr.emit("handoff-wait", m, diagnosticFields{})
+		if tr.status().Dropped == 0 || tr.status().Qualification != "UNMEASURED" {
+			t.Fatal("SATURATION_MUST_REFUSE")
+		}
+	}
+	tr := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", diagnosticShortWriter{}, 4096, 2097152)
+	tr.emit("message-ready", tr.bind(diagnosticEvent(diagnosticA, "0/100")), diagnosticFields{})
+	if tr.status().Failed != "WRITE_REFUSED" || tr.status().Qualification != "UNMEASURED" {
+		t.Fatal("SHORT_WRITE_MUST_REFUSE")
+	}
+	var b bytes.Buffer
+	tr = newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &b, 4096, 2097152)
+	event := diagnosticEvent(diagnosticA, "ARBITRARY_SECRET")
+	event.Data.Columns[1].Value = "STAMP_SECRET"
+	tr.emit("message-ready", tr.bind(event), diagnosticFields{})
+	if bytes.Contains(b.Bytes(), []byte("SECRET")) || tr.status().Qualification != "UNMEASURED" {
+		t.Fatal("INVALID_IDENTITY_MUST_REFUSE")
+	}
+}
