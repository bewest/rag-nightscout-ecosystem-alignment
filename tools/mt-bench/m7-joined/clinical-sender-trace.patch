+func TestClinicalDiagnosticNoFalseTarget(t *testing.T) {
+	var buffer bytes.Buffer
+	trace := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &buffer, 4096, 2097152)
+	if trace.bind(diagnosticEvent("33333333-3333-4333-8333-333333333333", "0/100")) != nil {
+		t.Fatal("UNSELECTED_SHARED_LSN_NOT_TARGET")
+	}
+	wrongSchema := diagnosticEvent(diagnosticA, "0/100")
+	wrongSchema.Data.Schema = "unrelated"
+	if trace.bind(wrongSchema) != nil {
+		t.Fatal("WRONG_SCHEMA_NOT_TARGET")
+	}
+	zero := trace.bind(diagnosticEvent(diagnosticA, wal.ZeroLSN))
+	if zero == nil || zero.lsn != "UNMEASURED" || trace.status().Qualification != "UNMEASURED" {
+		t.Fatal("ZERO_LSN_MUST_NOT_JOIN")
+	}
+	trace = newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &buffer, 4096, 2097152)
+	n := New(&Config{Backoff: backoff.Config{DisableRetries: true}}, nil)
+	n.diagnosticTrace = trace
+	n.subscriptionStore = &diagnosticEmptyStore{}
+	received := make(chan *notifyMsg, 1)
+	go func() { received <- <-n.notifyChan }()
+	if err := n.ProcessWALEvent(context.Background(), diagnosticEvent(diagnosticA, "0/100")); err != nil {
+		t.Fatal(err)
+	}
+	message := <-received
+	if message.diagnostic != nil || trace.status().Rows != 0 {
+		t.Fatal("UNSUBSCRIBED_NOT_A_TARGET_DELIVERY")
+	}
+}
