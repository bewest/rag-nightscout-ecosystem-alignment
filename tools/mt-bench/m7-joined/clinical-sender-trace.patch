+// SPDX-License-Identifier: Apache-2.0
+package notifier
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"github.com/xataio/pgstream/pkg/backoff"
+	"github.com/xataio/pgstream/pkg/wal"
+	"github.com/xataio/pgstream/pkg/wal/processor/webhook/subscription"
+	"io"
+	"net/http"
+	"net/http/httptrace"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+const diagnosticA = "11111111-1111-4111-8111-111111111111"
+const diagnosticB = "22222222-2222-4222-8222-222222222222"
+
+type diagnosticClient func(*http.Request) (*http.Response, error)
+
+func (f diagnosticClient) Do(r *http.Request) (*http.Response, error) { return f(r) }
+
+type diagnosticStore struct{}
+
+func (diagnosticStore) GetSubscriptions(context.Context, string, string, string) ([]*subscription.Subscription, error) {
+	return []*subscription.Subscription{{URL: "http://evaluator:19913/pgstream"}}, nil
+}
+func diagnosticEvent(id, lsn string) *wal.Event {
+	return &wal.Event{Data: &wal.Data{Table: "tenant_write_clock", Schema: "synthetic", LSN: lsn, Columns: []wal.Column{{Name: "tenant_id", Value: id}, {Name: "last_stamp", Value: "2"}}}, CommitPosition: wal.CommitPosition("0/DEAD")}
+}
+func diagnosticRows(t *testing.T, tr *diagnosticTrace, b *bytes.Buffer) []diagnosticRecord {
+	t.Helper()
+	tr.mu.Lock()
+	raw := append([]byte(nil), b.Bytes()...)
+	tr.mu.Unlock()
+	var result []diagnosticRecord
+	for _, line := range bytes.Split(bytes.TrimSpace(raw), []byte("\n")) {
+		if len(line) == 0 {
+			continue
+		}
+		var r diagnosticRecord
+		if err := json.Unmarshal(line, &r); err != nil {
+			t.Fatal(err)
+		}
+		result = append(result, r)
+	}
+	return result
+}
+func diagnosticPhase(rows []diagnosticRecord, phase, tenant string) bool {
+	for _, r := range rows {
+		if r.Phase == phase && r.Tenant == tenant {
+			return true
+		}
+	}
+	return false
+}
+func diagnosticAwait(t *testing.T, tr *diagnosticTrace, b *bytes.Buffer, phase, tenant string) {
+	t.Helper()
+	deadline := time.After(time.Second)
+	for {
+		if diagnosticPhase(diagnosticRows(t, tr, b), phase, tenant) {
+			return
+		}
+		select {
+		case <-deadline:
+			t.Fatalf("MISSING_PHASE_%s", phase)
+		case <-time.After(time.Millisecond):
+		}
+	}
+}
+func TestClinicalDiagnosticHandoff(t *testing.T) {
+	var buffer bytes.Buffer
+	trace := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &buffer, 4096, 2097152)
+	n := New(&Config{URLWorkerCount: 1, Backoff: backoff.Config{DisableRetries: true}}, diagnosticStore{})
+	n.diagnosticTrace = trace
+	entered, release := make(chan struct{}), make(chan struct{})
+	var calls int
+	var lock sync.Mutex
+	n.client = diagnosticClient(func(req *http.Request) (*http.Response, error) {
+		lock.Lock()
+		calls++
+		first := calls == 1
+		lock.Unlock()
+		if first {
+			close(entered)
+			<-release
+		}
+		return &http.Response{StatusCode: 204, Body: io.NopCloser(strings.NewReader(""))}, nil
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	notified := make(chan error, 1)
+	go func() { notified <- n.Notify(ctx) }()
+	first := make(chan error, 1)
+	go func() { first <- n.ProcessWALEvent(ctx, diagnosticEvent(diagnosticA, "0/100")) }()
+	<-entered
+	if err := <-first; err != nil {
+		t.Fatal(err)
+	}
+	second := make(chan error, 1)
+	go func() { second <- n.ProcessWALEvent(ctx, diagnosticEvent(diagnosticB, "0/200")) }()
+	diagnosticAwait(t, trace, &buffer, "handoff-wait", diagnosticB)
+	before := diagnosticRows(t, trace, &buffer)
+	if diagnosticPhase(before, "notify-consumed", diagnosticB) {
+		t.Fatal("SECOND_CONSUMED_WHILE_FIRST_HELD")
+	}
+	select {
+	case <-second:
+		t.Fatal("UNBUFFERED_HANDOFF_BYPASSED")
+	default:
+	}
+	close(release)
+	if err := <-second; err != nil {
+		t.Fatal(err)
+	}
+	diagnosticAwait(t, trace, &buffer, "send-return", diagnosticB)
+	cancel()
+	<-notified
+	rows := diagnosticRows(t, trace, &buffer)
+	for _, id := range []string{diagnosticA, diagnosticB} {
+		for _, phase := range []string{"message-ready", "handoff-wait", "notify-consumed", "send-call", "send-return"} {
+			if !diagnosticPhase(rows, phase, id) {
+				t.Fatalf("REQUIRED_%s", phase)
+			}
+		}
+	}
+	if trace.status().Failed != "" || trace.status().Dropped != 0 {
+		t.Fatal(trace.status())
+	}
+	for _, r := range rows {
+		if r.DataLSN == "0/DEAD" {
+			t.Fatal("COMMIT_POSITION_IS_NOT_DATA_LSN")
+		}
+	}
+}
+func TestClinicalDiagnosticRetryForwarding(t *testing.T) {
+	run := func(instrumented bool) ([][]byte, []string, []diagnosticRecord, int) {
+		var buffer bytes.Buffer
+		tr := newDiagnosticTrace([]string{diagnosticA, diagnosticB}, "synthetic", &buffer, 4096, 2097152)
+		n := New(&Config{URLWorkerCount: 1, Backoff: backoff.Config{Constant: &backoff.ConstantConfig{Interval: time.Millisecond, MaxRetries: 1}}}, diagnosticStore{})
+		if instrumented {
+			n.diagnosticTrace = tr
+		}
+		var bodies [][]byte
+		var headers []string
+		originalTraceCalls := 0
+		baseContext, cancelContext := context.WithTimeout(context.WithValue(context.Background(), diagnosticContextKey{}, "original-context"), time.Second)
+		defer cancelContext()
+		ctx := httptrace.WithClientTrace(baseContext, &httptrace.ClientTrace{WroteRequest: func(httptrace.WroteRequestInfo) { originalTraceCalls++ }})
+		n.client = diagnosticClient(func(req *http.Request) (*http.Response, error) {
+			if req.Context().Value(diagnosticContextKey{}) != "original-context" || req.Context().Done() != ctx.Done() {
+				t.Fatal("CONTEXT_CHANGED")
+			}
+			actualDeadline, actualOK := req.Context().Deadline()
+			originalDeadline, originalOK := ctx.Deadline()
+			if actualOK != originalOK || !actualDeadline.Equal(originalDeadline) {
+				t.Fatal("DEADLINE_CHANGED")
+			}
+			body, err := io.ReadAll(req.Body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(body) != "unchanged-body" {
+				t.Fatal("REQUEST_BODY_CHANGED")
+			}
+			bodies = append(bodies, body)
+			headers = append(headers, req.Header.Get("X-Pgstream-LSN")+"/"+req.Header.Get("Idempotency-Key"))
+			if req.Method != "POST" || req.URL.String() != "http://evaluator:19913/pgstream" {
+				t.Fatal("REQUEST_CHANGED")
+			}
+			c := httptrace.ContextClientTrace(req.Context())
+			if c.WroteHeaders != nil {
+				c.WroteHeaders()
+			}
+			if c.WroteRequest != nil {
+				c.WroteRequest(httptrace.WroteRequestInfo{})
+			}
+			if len(bodies) == 1 {
+				return nil, errors.New("DO_NOT_EMIT_SECRET")
+			}
+			if c.GotFirstResponseByte != nil {
+				c.GotFirstResponseByte()
+			}
+			return &http.Response{StatusCode: 204, Body: io.NopCloser(strings.NewReader(""))}, nil
+		})
+		event := diagnosticEvent(diagnosticA, "0/100")
+		var m *diagnosticMessage
+		if instrumented {
+			m = tr.bind(event)
+		}
+		if err := n.sendWebhook(ctx, []byte("unchanged-body"), event.Data.LSN, "http://evaluator:19913/pgstream", m); err != nil {
+			t.Fatal(err)
+		}
+		tr.seal()
+		rows := diagnosticRows(t, tr, &buffer)
+		if bytes.Contains(buffer.Bytes(), []byte("DO_NOT_EMIT_SECRET")) {
+			t.Fatal("ARBITRARY_ERROR_LEAK")
+		}
+		return bodies, headers, rows, originalTraceCalls
+	}
+	baseBodies, baseHeaders, _, baseCalls := run(false)
+	bodies, headers, rows, calls := run(true)
+	if len(bodies) != 2 || !bytes.Equal(baseBodies[0], bodies[0]) || !bytes.Equal(baseBodies[1], bodies[1]) || strings.Join(baseHeaders, "|") != strings.Join(headers, "|") || calls != baseCalls || calls != 2 {
+		t.Fatal("FORWARDING_OR_RETRY_CHANGED")
+	}
+	attempts := map[uint64]bool{}
+	for _, r := range rows {
+		if r.Phase == "send-call" {
+			if r.Attempt == 0 || attempts[r.Attempt] {
+				t.Fatal("ATTEMPT_IDENTITY_REQUIRED")
+			}
+			attempts[r.Attempt] = true
+		}
+	}
+	if len(attempts) != 2 {
+		t.Fatal("TWO_ATTEMPTS_REQUIRED")
+	}
+	for _, phase := range []string{"transport-wrote-headers", "transport-wrote-request", "transport-first-response-byte"} {
+		if !diagnosticPhase(rows, phase, diagnosticA) {
+			t.Fatalf("REQUIRED_%s", phase)
+		}
+	}
+}
