+// SPDX-License-Identifier: Apache-2.0
+// Experimental fixture instrumentation; disabled unless explicitly selected.
+package notifier
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/xataio/pgstream/pkg/wal"
+	"io"
+	"net"
+	"net/http/httptrace"
+	"net/url"
+	"os"
+	"regexp"
+	"strconv"
+	"sync"
+	"time"
+)
+
+var diagnosticSchema = regexp.MustCompile(`^[a-z][a-z0-9_]{0,62}$`)
+var diagnosticUUID = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var diagnosticLSN = regexp.MustCompile(`^[0-9A-F]{1,8}/[0-9A-F]{1,8}$`)
+var diagnosticStamp = regexp.MustCompile(`^[0-9]{1,20}$`)
+
+type diagnosticMessage struct {
+	message            uint64
+	tenant, stamp, lsn string
+}
+type diagnosticFields struct {
+	Attempt     uint64 `json:"attempt,omitempty"`
+	Destination string `json:"destination,omitempty"`
+	Outcome     string `json:"outcome,omitempty"`
+	Status      int    `json:"status,omitempty"`
+	LocalPort   int    `json:"localPort,omitempty"`
+	RemotePort  int    `json:"remotePort,omitempty"`
+	Reused      bool   `json:"reused,omitempty"`
+}
+type diagnosticRecord struct {
+	Instance  string `json:"instance"`
+	PID       int    `json:"pid"`
+	Sequence  uint64 `json:"sequence"`
+	Phase     string `json:"phase"`
+	WallNs    int64  `json:"wallNs"`
+	ElapsedNs int64  `json:"elapsedNs"`
+	Message   uint64 `json:"message"`
+	Tenant    string `json:"tenant"`
+	Stamp     string `json:"stamp"`
+	DataLSN   string `json:"dataLsn"`
+	diagnosticFields
+}
+type diagnosticStatus struct {
+	Rows          uint64 `json:"rows"`
+	Bytes         int    `json:"bytes"`
+	Dropped       uint64 `json:"dropped"`
+	Failed        string `json:"failed"`
+	Closed        bool   `json:"closed"`
+	Qualification string `json:"qualification"`
+}
+type diagnosticTrace struct {
+	instance                          string
+	schema                            string
+	mu                                sync.Mutex
+	ids                               map[string]bool
+	writer                            io.Writer
+	started                           time.Time
+	rows, messages, attempts, dropped uint64
+	bytes, maxRows, maxBytes          int
+	failed                            string
+	closed                            bool
+	statusFile                        string
+	owned                             *os.File
+}
+
+func newDiagnosticTrace(ids []string, schema string, w io.Writer, maxRows, maxBytes int) *diagnosticTrace {
+	if !diagnosticSchema.MatchString(schema) || len(ids) != 2 || ids[0] == ids[1] || !diagnosticUUID.MatchString(ids[0]) || !diagnosticUUID.MatchString(ids[1]) || w == nil || maxRows < 1 || maxRows > 4096 || maxBytes < 1 || maxBytes > 2097152 {
+		panic("M7_CLINICAL_SENDER_BINDING")
+	}
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		panic("M7_CLINICAL_SENDER_INSTANCE")
+	}
+	return &diagnosticTrace{instance: hex.EncodeToString(nonce[:]), schema: schema, ids: map[string]bool{ids[0]: true, ids[1]: true}, writer: w, started: time.Now(), maxRows: maxRows, maxBytes: maxBytes}
+}
+func diagnosticTraceFromEnvironment() *diagnosticTrace {
+	if os.Getenv("NS_M7_CLINICAL_SENDER_TIMELINE") != "1" {
+		return nil
+	}
+	raw, err := os.ReadFile("/run/ns-intake-timeline/targets.json")
+	if err != nil {
+		panic("M7_CLINICAL_SENDER_TARGETS")
+	}
+	var target struct {
+		IDs         []string `json:"ids"`
+		ClockSchema string   `json:"clockSchema"`
+	}
+	if json.Unmarshal(raw, &target) != nil {
+		panic("M7_CLINICAL_SENDER_TARGETS")
+	}
+	// The constructor validates before opening output. No public/network configuration.
+	t := newDiagnosticTrace(target.IDs, target.ClockSchema, io.Discard, 4096, 2097152)
+	file, err := os.OpenFile("/run/ns-ipc/clinical-sender-timeline.jsonl", os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		panic("M7_CLINICAL_SENDER_OUTPUT")
+	}
+	t.writer = file
+	t.owned = file
+	t.statusFile = "/run/ns-ipc/clinical-sender-status.json"
+	return t
+}
+func (t *diagnosticTrace) bind(event *wal.Event) *diagnosticMessage {
+	if t == nil || event == nil || event.Data == nil || event.Data.Schema != t.schema || event.Data.Table != "tenant_write_clock" {
+		return nil
+	}
+	var tenant, stamp string
+	for _, columns := range [][]wal.Column{event.Data.Identity, event.Data.Columns} {
+		for _, column := range columns {
+			if column.Name == "tenant_id" {
+				tenant, _ = column.Value.(string)
+			}
+			if column.Name == "last_stamp" {
+				switch value := column.Value.(type) {
+				case string:
+					stamp = value
+				case int64:
+					stamp = strconv.FormatInt(value, 10)
+				case json.Number:
+					stamp = string(value)
+				}
+			}
+		}
+	}
+	if !t.ids[tenant] {
+		return nil
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.messages++
+	lsn := event.Data.LSN
+	if lsn == wal.ZeroLSN || !diagnosticLSN.MatchString(lsn) || !diagnosticStamp.MatchString(stamp) {
+		t.failed = "TARGET_BINDING_UNMEASURED"
+		lsn = "UNMEASURED"
+		stamp = "UNMEASURED"
+	}
+	return &diagnosticMessage{message: t.messages, tenant: tenant, stamp: stamp, lsn: lsn}
+}
+func (t *diagnosticTrace) emit(phase string, m *diagnosticMessage, fields diagnosticFields) {
+	if t == nil || m == nil {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.closed {
+		return
+	} // Structural qualification also requires all expected attempt/terminal phases.
+	now := time.Now()
+	record := diagnosticRecord{Instance: t.instance, PID: os.Getpid(), Sequence: t.rows + 1, Phase: phase, WallNs: now.UnixNano(), ElapsedNs: now.Sub(t.started).Nanoseconds(), Message: m.message, Tenant: m.tenant, Stamp: m.stamp, DataLSN: m.lsn, diagnosticFields: fields}
+	raw, err := json.Marshal(record)
+	if err != nil {
+		t.failed = "ENCODE_REFUSED"
+		return
+	}
+	raw = append(raw, '\n')
+	if t.rows >= uint64(t.maxRows) || t.bytes+len(raw) > t.maxBytes {
+		t.dropped++
+		return
+	}
+	t.rows++
+	t.bytes += len(raw)
+	n, err := t.writer.Write(raw)
+	if err != nil || n != len(raw) {
+		t.failed = "WRITE_REFUSED"
+	}
+}
+func (t *diagnosticTrace) attempt(m *diagnosticMessage, destination string) diagnosticFields {
+	if t == nil || m == nil {
+		return diagnosticFields{}
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	t.attempts++
+	role := "UNMEASURED"
+	u, err := url.Parse(destination)
+	if err == nil {
+		switch u.Hostname() {
+		case "evaluator":
+			role = "evaluator"
+		case "realtime":
+			role = "realtime"
+		}
+	}
+	if role == "UNMEASURED" {
+		t.failed = "DESTINATION_UNMEASURED"
+	}
+	return diagnosticFields{Attempt: t.attempts, Destination: role}
+}
+func diagnosticPort(address net.Addr) int {
+	if address == nil {
+		return 0
+	}
+	_, port, err := net.SplitHostPort(address.String())
+	if err != nil {
+		return 0
+	}
+	value, err := strconv.Atoi(port)
+	if err != nil || value < 1 || value > 65535 {
+		return 0
+	}
+	return value
+}
+func (t *diagnosticTrace) transport(m *diagnosticMessage, fields diagnosticFields) *httptrace.ClientTrace {
+	// Callback observations never replace the transport, response or request body.
+	return &httptrace.ClientTrace{
+		GotConn: func(info httptrace.GotConnInfo) {
+			f := fields
+			f.Reused = info.Reused
+			if info.Conn != nil {
+				f.LocalPort = diagnosticPort(info.Conn.LocalAddr())
+				f.RemotePort = diagnosticPort(info.Conn.RemoteAddr())
+			}
+			t.emit("transport-got-conn", m, f)
+		},
+		WroteHeaders: func() { t.emit("transport-wrote-headers", m, fields) },
+		WroteRequest: func(info httptrace.WroteRequestInfo) {
+			f := fields
+			f.Outcome = "WRITTEN"
+			if info.Err != nil {
+				f.Outcome = "REFUSED"
+			}
+			t.emit("transport-wrote-request", m, f)
+		},
+		GotFirstResponseByte: func() { t.emit("transport-first-response-byte", m, fields) },
+	}
+}
+func (t *diagnosticTrace) status() diagnosticStatus {
+	if t == nil {
+		return diagnosticStatus{Qualification: "DISABLED"}
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	q := "CAPTURED_REQUIRES_STRUCTURAL_CHECK"
+	if t.dropped > 0 || t.failed != "" {
+		q = "UNMEASURED"
+	}
+	return diagnosticStatus{t.rows, t.bytes, t.dropped, t.failed, t.closed, q}
+}
+func (t *diagnosticTrace) seal() {
+	if t == nil {
+		return
+	}
+	t.mu.Lock()
+	t.closed = true
+	if t.owned != nil {
+		if t.owned.Sync() != nil {
+			t.failed = "SYNC_REFUSED"
+		}
+		if t.owned.Close() != nil {
+			t.failed = "CLOSE_REFUSED"
+		}
+	}
+	t.mu.Unlock()
+	if t.statusFile != "" {
+		raw, _ := json.Marshal(t.status())
+		file, err := os.OpenFile(t.statusFile, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+		if err != nil {
+			return
+		}
+		defer file.Close()
+		_, _ = file.Write(append(raw, '\n'))
+		_ = file.Sync()
+	}
+}
