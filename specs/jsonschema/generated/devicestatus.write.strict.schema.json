{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nightscout.dev/schemas/devicestatus.write.strict.json",
 "title": "Nightscout devicestatus (write, strict)",
 "description": "Generated by tools/nsschema/emit/jsonschema_emit.py from aid-devicestatus-2025.yaml reconciled against reports/schema-census/devicestatus.census.json. Do not edit by hand.",
 "type": "object",
 "properties": {
  "_id": {
   "type": "string"
  },
  "configuration": {
   "type": "object",
   "description": "Algorithm configuration snapshot (AAPS only)",
   "additionalProperties": false
  },
  "created_at": {
   "type": "string",
   "format": "date-time"
  },
  "device": {
   "type": "string",
   "description": "Device identifier string. Format varies by system:",
   "x-observed-values": [
    "loop://iPhone"
   ]
  },
  "identifier": {
   "type": "string"
  },
  "isCharging": {
   "type": "boolean",
   "description": "Charging status (AAPS)"
  },
  "isValid": {
   "type": "boolean"
  },
  "loop": {
   "type": "object",
   "description": "Loop-specific status. Uses FLAT structure with direct children.",
   "properties": {
    "automaticDoseRecommendation": {
     "type": "object",
     "properties": {
      "bolusVolume": {
       "type": "number",
       "description": "Recommended auto-bolus (U)"
      },
      "tempBasalAdjustment": {
       "type": "object",
       "properties": {
        "duration": {
         "type": "number",
         "description": "Duration in SECONDS"
        },
        "rate": {
         "type": "number",
         "description": "Recommended temp basal (U/hr)"
        }
       },
       "additionalProperties": false
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      }
     },
     "additionalProperties": false
    },
    "cob": {
     "type": "object",
     "properties": {
      "cob": {
       "type": "number",
       "description": "Carbs on board (g)"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      }
     },
     "additionalProperties": false
    },
    "enacted": {
     "type": "object",
     "properties": {
      "bolusVolume": {
       "type": "number",
       "description": "Enacted auto-bolus (U)"
      },
      "duration": {
       "type": "number",
       "description": "Duration in SECONDS"
      },
      "rate": {
       "type": "number",
       "description": "Enacted temp basal rate (U/hr)"
      },
      "received": {
       "type": "boolean",
       "description": "Whether pump confirmed"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      }
     },
     "additionalProperties": false
    },
    "failureReason": {
     "type": "string",
     "description": "Error message if loop cycle failed"
    },
    "iob": {
     "type": "object",
     "properties": {
      "iob": {
       "type": "number",
       "description": "Total insulin on board (U)"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      }
     },
     "additionalProperties": false
    },
    "name": {
     "type": "string",
     "description": "App bundle name"
    },
    "predicted": {
     "type": "object",
     "description": "Loop prediction - SINGLE COMBINED CURVE.",
     "properties": {
      "startDate": {
       "type": "string",
       "format": "date-time"
      },
      "values": {
       "type": "array",
       "description": "Predicted BG values at 5-minute intervals.",
       "items": {
        "type": "number"
       }
      }
     },
     "additionalProperties": false
    },
    "recommendedBolus": {
     "type": "number",
     "description": "Recommended manual bolus (U)"
    },
    "timestamp": {
     "type": "string",
     "format": "date-time"
    },
    "version": {
     "type": "string",
     "description": "App version",
     "x-observed-values": [
      "3.12.1.<n>",
      "3.6.2.<n>",
      "3.8.1.<n>"
     ]
    }
   },
   "additionalProperties": false
  },
  "mills": {
   "type": "integer",
   "description": "Epoch milliseconds"
  },
  "openaps": {
   "type": "object",
   "description": "oref0-based status (AAPS, Trio, OpenAPS). Uses NESTED structure.",
   "properties": {
    "enacted": {
     "type": "object",
     "description": "Actually enacted recommendation.",
     "properties": {
      "duration": {
       "type": "integer",
       "description": "Duration in MINUTES"
      },
      "predBGs": {
       "type": "object",
       "description": "Four prediction curves, each representing a different scenario.",
       "properties": {
        "COB": {
         "type": "array",
         "description": "Prediction including expected carb absorption.",
         "items": {
          "type": "integer"
         }
        },
        "IOB": {
         "type": "array",
         "description": "Prediction assuming no carb absorption.",
         "items": {
          "type": "integer"
         }
        },
        "UAM": {
         "type": "array",
         "description": "Unannounced Meal prediction.",
         "items": {
          "type": "integer"
         }
        },
        "ZT": {
         "type": "array",
         "description": "Zero Temp prediction.",
         "items": {
          "type": "integer"
         }
        }
       },
       "additionalProperties": false
      },
      "rate": {
       "type": "number",
       "description": "Enacted rate (U/hr)"
      },
      "received": {
       "type": "boolean",
       "description": "Pump confirmation status"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      },
      "units": {
       "type": "number",
       "description": "Enacted SMB units"
      }
     },
     "additionalProperties": false
    },
    "iob": {
     "type": "object",
     "description": "IOB breakdown with component separation (unlike Loop).",
     "properties": {
      "activity": {
       "type": "number",
       "description": "Current insulin activity (U/hr)"
      },
      "basaliob": {
       "type": "number",
       "description": "IOB from temp basals (U)"
      },
      "bolussnooze": {
       "type": "number",
       "description": "IOB from recent boluses affecting snooze"
      },
      "iob": {
       "type": "number",
       "description": "Total IOB (U)"
      },
      "lastBolusTime": {
       "type": "integer",
       "description": "Timestamp of last bolus (epoch ms)"
      },
      "lastTemp": {
       "type": "object",
       "properties": {
        "duration": {
         "type": "number"
        },
        "rate": {
         "type": "number"
        },
        "started_at": {
         "type": "string",
         "format": "date-time"
        }
       },
       "additionalProperties": false
      }
     },
     "additionalProperties": false
    },
    "suggested": {
     "type": "object",
     "description": "Algorithm suggestion. Always present.",
     "properties": {
      "COB": {
       "type": "integer",
       "description": "Carbs on board (g)"
      },
      "IOB": {
       "type": "number",
       "description": "Insulin on board (U)"
      },
      "bg": {
       "type": "integer",
       "description": "Current BG (mg/dL)"
      },
      "deliverAt": {
       "type": "string",
       "format": "date-time"
      },
      "duration": {
       "type": "integer",
       "description": "Duration in MINUTES (oref0 convention)"
      },
      "eventualBG": {
       "type": "integer",
       "description": "Predicted eventual BG"
      },
      "insulinReq": {
       "type": "number",
       "description": "Insulin required to reach target"
      },
      "predBGs": {
       "type": "object",
       "description": "Four prediction curves, each representing a different scenario.",
       "properties": {
        "COB": {
         "type": "array",
         "description": "Prediction including expected carb absorption.",
         "items": {
          "type": "integer"
         }
        },
        "IOB": {
         "type": "array",
         "description": "Prediction assuming no carb absorption.",
         "items": {
          "type": "integer"
         }
        },
        "UAM": {
         "type": "array",
         "description": "Unannounced Meal prediction.",
         "items": {
          "type": "integer"
         }
        },
        "ZT": {
         "type": "array",
         "description": "Zero Temp prediction.",
         "items": {
          "type": "integer"
         }
        }
       },
       "additionalProperties": false
      },
      "rate": {
       "type": "number",
       "description": "Suggested temp basal rate (U/hr)"
      },
      "reason": {
       "type": "string",
       "description": "Human-readable explanation of recommendation"
      },
      "sensitivityRatio": {
       "type": "number",
       "description": "Autosens ratio (1.0 = normal)"
      },
      "targetBG": {
       "type": "integer",
       "description": "Current target BG"
      },
      "tick": {
       "type": "string",
       "description": "BG delta indicator (+, -, etc.)"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      },
      "units": {
       "type": "number",
       "description": "SMB units to deliver"
      },
      "variable_sens": {
       "type": "number",
       "description": "Dynamic ISF value (AAPS DynamicISF)"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "override": {
   "type": "object",
   "description": "Loop active override (Loop only)",
   "properties": {
    "active": {
     "type": "boolean"
    },
    "currentCorrectionRange": {
     "type": "object",
     "properties": {
      "maxValue": {
       "type": "number"
      },
      "minValue": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    "duration": {
     "type": "number",
     "description": "Duration in seconds (Loop convention)"
    },
    "multiplier": {
     "type": "number",
     "description": "Overall insulin needs multiplier"
    },
    "name": {
     "type": "string"
    },
    "timestamp": {
     "type": "string",
     "format": "date-time"
    }
   },
   "additionalProperties": false
  },
  "pump": {
   "type": "object",
   "description": "Pump status (may be absent if communication failed)",
   "properties": {
    "battery": {
     "type": "object",
     "properties": {
      "percent": {
       "type": "integer"
      },
      "status": {
       "type": "string",
       "enum": [
        "critical",
        "low",
        "normal"
       ]
      },
      "voltage": {
       "type": "number"
      }
     },
     "additionalProperties": false
    },
    "clock": {
     "type": "string",
     "description": "Pump internal clock",
     "format": "date-time"
    },
    "extended": {
     "type": "object",
     "description": "Pump-specific extended data",
     "additionalProperties": false
    },
    "reservoir": {
     "type": "number",
     "description": "Reservoir level (U)"
    },
    "status": {
     "type": "object",
     "properties": {
      "bolusing": {
       "type": "boolean"
      },
      "status": {
       "type": "string"
      },
      "suspended": {
       "type": "boolean"
      },
      "timestamp": {
       "type": "string",
       "format": "date-time"
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "srvCreated": {
   "type": "integer"
  },
  "srvModified": {
   "type": "integer"
  },
  "uploader": {
   "type": "object",
   "properties": {
    "battery": {
     "type": "integer",
     "description": "Phone/rig battery percentage"
    },
    "batteryVoltage": {
     "type": "number"
    },
    "name": {
     "type": "string",
     "description": "Uploader device name"
    }
   },
   "additionalProperties": false
  },
  "uploaderBattery": {
   "type": "integer",
   "description": "Alternate battery field (AAPS)"
  },
  "utcOffset": {
   "type": "integer"
  }
 },
 "required": [
  "created_at",
  "device"
 ],
 "additionalProperties": false
}
