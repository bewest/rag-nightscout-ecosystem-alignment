{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://nightscout.dev/schemas/treatments.read.permissive.json",
 "title": "Nightscout treatments (read, permissive)",
 "description": "Generated by tools/nsschema/emit/jsonschema_emit.py from aid-treatments-2025.yaml reconciled against reports/schema-census/treatments.census.json. Do not edit by hand.",
 "type": "object",
 "properties": {
  "_id": {
   "type": "string",
   "description": "MongoDB document ID"
  },
  "absolute": {
   "type": "number",
   "description": "Temp basal as absolute rate (U/hr)"
  },
  "absorptionTime": {
   "type": "integer",
   "description": "Carb absorption time in MINUTES (Nightscout convention)."
  },
  "amount": {
   "type": "number"
  },
  "app": {
   "type": "string",
   "description": "Application identifier"
  },
  "automatic": {
   "type": "boolean",
   "description": "Whether insulin was automatically delivered."
  },
  "bolusType": {
   "type": "string",
   "description": "Bolus delivery pattern:",
   "enum": [
    "Dual",
    "Normal",
    "Square"
   ]
  },
  "carbs": {
   "type": [
    "null",
    "number"
   ],
   "description": "Carbohydrates in grams",
   "minimum": 0
  },
  "correctionRange": {
   "type": "array",
   "items": {
    "type": "number"
   }
  },
  "created_at": {
   "type": "string",
   "description": "Event timestamp (ISO 8601)",
   "format": "date-time"
  },
  "device": {
   "type": "string",
   "description": "Device identifier"
  },
  "duration": {
   "type": "number",
   "description": "Duration in MINUTES for temp basal, override, eCarbs."
  },
  "enteredBy": {
   "type": "string",
   "description": "User/device nickname that created treatment."
  },
  "eventType": {
   "type": "string",
   "description": "Treatment classification. This is the primary discriminator for treatment types.",
   "x-observed-values": [
    "Carb Correction",
    "Correction Bolus",
    "Sensor Start",
    "Site Change",
    "Temp Basal",
    "Temporary Override"
   ]
  },
  "fat": {
   "type": "number",
   "description": "Fat grams (for FPU calculation)"
  },
  "foodType": {
   "type": "string",
   "description": "Food category/description"
  },
  "glucose": {
   "type": "number",
   "description": "Blood glucose value at time of treatment"
  },
  "glucoseType": {
   "type": "string",
   "description": "Source of glucose reading"
  },
  "identifier": {
   "type": "string",
   "description": "API v3 primary key. Server-assigned."
  },
  "insulin": {
   "type": [
    "null",
    "number"
   ],
   "description": "Insulin amount in Units",
   "minimum": 0
  },
  "insulinNeedsScaleFactor": {
   "type": "number"
  },
  "insulinType": {
   "type": "string",
   "description": "Insulin product name (Humalog, NovoRapid, Fiasp, etc.)",
   "x-observed-values": [
    "Humalog",
    "Novolog"
   ]
  },
  "isBasalInsulin": {
   "type": "boolean",
   "description": "AAPS MDI basal injection tracking"
  },
  "isReadOnly": {
   "type": "boolean"
  },
  "isValid": {
   "type": "boolean"
  },
  "modifiedBy": {
   "type": "string"
  },
  "notes": {
   "type": "string",
   "description": "Free-form notes"
  },
  "percent": {
   "type": "number",
   "description": "Temp basal as percentage of scheduled basal"
  },
  "percentage": {
   "type": "integer",
   "description": "AAPS profile percentage (100 = normal)"
  },
  "profile": {
   "type": "string",
   "description": "Profile name for profile switch"
  },
  "profileJson": {
   "type": "string",
   "description": "Full profile JSON (for inline profile switch)"
  },
  "programmed": {
   "type": "number",
   "description": "Originally programmed insulin (before cancellation)"
  },
  "protein": {
   "type": "number",
   "description": "Protein grams (for FPU calculation)"
  },
  "pumpId": {
   "type": "integer",
   "description": "Pump internal ID for this treatment"
  },
  "pumpSerial": {
   "type": "string",
   "description": "Pump serial number"
  },
  "pumpType": {
   "type": "string",
   "description": "Pump type enum name"
  },
  "rate": {
   "type": "number",
   "description": "Temp basal rate (U/hr) - alias for absolute"
  },
  "reason": {
   "type": "string",
   "description": "Override/temp target reason (e.g., \"Exercise\", \"Eating Soon\")"
  },
  "remoteAddress": {
   "type": "string"
  },
  "srvCreated": {
   "type": "integer"
  },
  "srvModified": {
   "type": "integer"
  },
  "subject": {
   "type": "string"
  },
  "syncIdentifier": {
   "type": "string",
   "description": "Client-assigned sync identity (UUID)."
  },
  "targetBottom": {
   "type": "number",
   "description": "Lower target glucose (mg/dL)"
  },
  "targetTop": {
   "type": "number",
   "description": "Upper target glucose (mg/dL)"
  },
  "temp": {
   "type": "string",
   "description": "Whether temp basal is expressed as rate or percentage",
   "enum": [
    "absolute",
    "percent"
   ]
  },
  "timeshift": {
   "type": "integer",
   "description": "AAPS profile time shift in hours"
  },
  "timestamp": {
   "type": [
    "integer",
    "string"
   ],
   "description": "Epoch milliseconds (alternative to created_at)"
  },
  "type": {
   "type": "string",
   "description": "AAPS-specific bolus subtype.",
   "enum": [
    "Normal",
    "Priming",
    "SMB",
    "normal"
   ]
  },
  "unabsorbed": {
   "type": "number",
   "description": "Unabsorbed insulin at time of bolus"
  },
  "userEnteredAt": {
   "type": "string"
  },
  "userLastModifiedAt": {
   "type": "string"
  },
  "utcOffset": {
   "type": "integer",
   "description": "Timezone offset in minutes"
  }
 },
 "required": [
  "_id",
  "carbs",
  "created_at",
  "enteredBy",
  "eventType",
  "insulin",
  "utcOffset"
 ],
 "additionalProperties": true
}
