   "type": "number",
   "description": "Lower target glucose (mg/dL)",
   "x-sensitivity": "descriptive",
   "x-data-category": "therapy-setting"
  },
  "targetTop": {
   "type": "number",
   "description": "Upper target glucose (mg/dL)",
   "x-sensitivity": "descriptive",
   "x-data-category": "therapy-setting"
  },
  "temp": {
   "type": "string",
   "description": "Whether temp basal is expressed as rate or percentage",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary",
   "enum": [
    "absolute",
    "percent"
   ]
  },
  "timeshift": {
   "type": "integer",
   "description": "AAPS profile time shift in hours",
   "x-sensitivity": "identifying",
   "x-data-category": "temporal"
  },
