   "type": "boolean",
   "x-sensitivity": "identifying",
   "x-data-category": "vocabulary"
  },
  "isValid": {
   "type": "boolean",
   "x-sensitivity": "identifying",
   "x-data-category": "vocabulary"
  },
  "modifiedBy": {
   "type": "string",
   "x-sensitivity": "identifying",
   "x-data-category": "identity"
  },
  "notes": {
   "type": "string",
   "description": "Free-form notes",
   "x-sensitivity": "identifying",
   "x-data-category": "free-text"
  },
  "percent": {
   "type": "number",
   "description": "Temp basal as percentage of scheduled basal",
   "x-sensitivity": "identifying",
   "x-data-category": "therapy-setting"
  },
  "percentage": {
   "type": "integer",
   "description": "AAPS profile percentage (100 = normal)",
   "x-sensitivity": "identifying",
   "x-data-category": "therapy-setting"
  },
  "profile": {
   "type": "string",
