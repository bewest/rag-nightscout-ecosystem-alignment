    "Dual",
    "Normal",
    "Square"
   ]
  },
  "carbs": {
   "type": [
    "null",
    "number"
   ],
   "description": "Carbohydrates in grams.",
   "x-sensitivity": "descriptive",
   "x-data-category": "health-measurement",
   "minimum": 0
  },
  "correctionRange": {
   "type": "array",
