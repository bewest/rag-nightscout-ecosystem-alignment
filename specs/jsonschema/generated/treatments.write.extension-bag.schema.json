    "Normal",
    "Priming",
    "SMB",
    "normal"
   ]
  },
  "unabsorbed": {
   "type": "number",
   "description": "Unabsorbed insulin at time of bolus",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "userEnteredAt": {
   "type": "string",
   "description": "When the user entered the treatment, as distinct from when it was",
   "x-sensitivity": "quasi-identifying",
   "x-data-category": "vocabulary",
   "format": "date-time"
  },
  "userLastModifiedAt": {
   "type": "string",
   "description": "When the user last edited the treatment.",
   "x-sensitivity": "quasi-identifying",
   "x-data-category": "temporal",
   "format": "date-time"
  },
  "utcOffset": {
   "type": "integer",
   "description": "Timezone offset in minutes",
   "x-sensitivity": "quasi-identifying",
   "x-data-category": "location"
  },
  "x-aid-extensions": {
   "type": "object",
   "description": "Vendor- or client-specific fields not part of the core schema. Observed in live data on a minority of sites.",
