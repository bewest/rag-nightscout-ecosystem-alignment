   "x-sensitivity": "identifying",
   "x-data-category": "therapy-setting"
  },
  "programmed": {
   "type": "number",
   "description": "Originally programmed insulin (before cancellation)",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "protein": {
   "type": "number",
   "description": "Protein grams (for FPU calculation)",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "pumpId": {
   "type": "integer",
   "description": "Pump internal ID for this treatment",
   "x-sensitivity": "identifying",
   "x-data-category": "device"
  },
  "pumpSerial": {
   "type": "string",
   "description": "Pump serial number",
   "x-sensitivity": "identifying",
   "x-data-category": "device"
  },
  "pumpType": {
   "type": "string",
   "description": "Pump type enum name",
   "x-sensitivity": "identifying",
   "x-data-category": "device"
  },
