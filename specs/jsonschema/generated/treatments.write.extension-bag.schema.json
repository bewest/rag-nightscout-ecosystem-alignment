 "type": "object",
 "properties": {
  "_id": {
   "type": "string",
   "description": "MongoDB document ID",
   "x-sensitivity": "identifying",
   "x-data-category": "identity"
  },
  "absolute": {
   "type": "number",
   "description": "Temp basal as absolute rate (U/hr)",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "absorptionTime": {
   "type": "integer",
   "description": "Carb absorption time in MINUTES (Nightscout convention).",
   "x-sensitivity": "descriptive",
   "x-data-category": "therapy-setting"
  },
  "amount": {
   "type": "number",
   "description": "Temp-basal rate or bolus amount, written alongside `rate` and",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "app": {
   "type": "string",
   "description": "Application identifier",
   "x-sensitivity": "identifying",
   "x-data-category": "vocabulary"
  },
  "automatic": {
   "type": "boolean",
   "description": "Whether insulin was automatically delivered.",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "bolusType": {
   "type": "string",
   "description": "Bolus delivery pattern:",
   "x-sensitivity": "identifying",
   "x-data-category": "vocabulary",
