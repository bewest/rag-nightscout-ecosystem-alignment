    "Carb Correction",
    "Correction Bolus",
    "Sensor Start",
    "Site Change",
    "Temp Basal",
    "Temporary Override"
   ]
  },
  "fat": {
   "type": "number",
   "description": "Fat grams (for FPU calculation)",
   "x-sensitivity": "descriptive",
   "x-data-category": "vocabulary"
  },
  "foodType": {
   "type": "string",
   "description": "Food category/description",
   "x-sensitivity": "quasi-identifying",
   "x-data-category": "vocabulary"
