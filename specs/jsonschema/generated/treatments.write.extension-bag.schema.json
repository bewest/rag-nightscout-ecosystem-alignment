   "type": "number",
   "description": "Temp basal rate (U/hr) - alias for absolute",
   "x-sensitivity": "descriptive",
   "x-data-category": "therapy-setting"
  },
  "reason": {
   "type": "string",
   "description": "Override/temp target reason (e.g., \"Exercise\", \"Eating Soon\")",
   "x-sensitivity": "identifying",
   "x-data-category": "free-text"
  },
